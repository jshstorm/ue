{
    // General VS Code settings for UE5 development
    "files.associations": {
        "*.uproject": "json",
        "*.uplugin": "json",
        "*.cs": "csharp",
        "*.h": "cpp",
        "*.cpp": "cpp",
        "*.hpp": "cpp",
        "*.inl": "cpp"
    },
    
    // C++ IntelliSense and formatting
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.compilerPath": "/usr/bin/clang++",
    "C_Cpp.default.intelliSenseMode": "macos-clang-x64",
    
    // File exclusions to improve performance
    "files.exclude": {
        "**/Binaries/**": true,
        "**/DerivedDataCache/**": true,
        "**/Intermediate/**": true,
        "**/Saved/**": true,
        "**/.vs/**": true,
        "**/.vscode/compileCommands_*": true
    },
    
    // Search exclusions
    "search.exclude": {
        "**/Binaries/**": true,
        "**/DerivedDataCache/**": true,
        "**/Intermediate/**": true,
        "**/Saved/**": true
    },
    
    // File watcher exclusions
    "files.watcherExclude": {
        "**/Binaries/**": true,
        "**/DerivedDataCache/**": true,
        "**/Intermediate/**": true,
        "**/Saved/**": true
    },
    
    // Code formatting
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "C_Cpp.formatting": "vcFormat",
    
    // Unreal Engine specific
    "C_Cpp.default.defines": [
        "UE_BUILD_DEVELOPMENT=1",
        "UE_BUILD_DEVELOPMENT_WITH_DEBUGGAME=0",
        "UE_BUILD_MINIMAL=0",
        "UE_BUILD_SHIPPING=0",
        "UE_BUILD_TEST=0",
        "UE_BUILD_DEBUG=0",
        "UE_GAME=1",
        "UE_EDITOR=0",
        "WITH_DEV_AUTOMATION_TESTS=1",
        "WITH_PERF_AUTOMATION_TESTS=1",
        "UNICODE=1",
        "_UNICODE=1",
        "PLATFORM_MAC=1",
        "WITH_EDITOR=1",
        "WITH_ENGINE=1"
    ],
    
    // Terminal settings
    "terminal.integrated.cwd": "${workspaceFolder}",
    
    // Git settings
    "git.ignoreLimitWarning": true
}